# Copy this file to .env and fill in your real keys.
# .env is git-ignored so your keys won't be committed.

# Original provider used by the upstream notebooks.
NEBIUS_API_KEY="YOUR_NEBIUS_API"

# Alternative OpenAI-compatible endpoint used by 03_ReAct.ipynb in this fork.
# Get a key at https://siliconflow.cn
SILICONFLOW_API_KEY="YOUR_SILICONFLOW_API"

# Optional: LangSmith tracing. Comment out LANGCHAIN_TRACING_V2 in the notebook
# if you don't want tracing.
LANGCHAIN_API_KEY="YOUR_LANGSMITH_API"

# Tavily web search, used as the agent's only tool.
# Free tier (1000 queries/month) at https://www.tavily.com
TAVILY_API_KEY="YOUR_TAVILY_API"
